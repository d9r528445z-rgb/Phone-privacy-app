<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for iOS to let the app reach the child's phone on the local network. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Family Guard connects to your child's phone on your Wi-Fi to show their activity reports. No data leaves your local network.</string>

    <!-- Allow plain HTTP only to local/private addresses (the child's phone on the LAN). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
</dict>
</plist>
